# Local development database (SQLite). For production PostgreSQL, switch the
# provider in prisma/schema.prisma to "postgresql" and point this at your DB.
DATABASE_URL="file:./dev.db"

# AI providers — leave empty to use the built-in mock provider.
# AI_PROVIDER can be: mock | openai | gemini
AI_PROVIDER="mock"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Affiliate platform APIs (v1 uses mock data / CSV import when empty)
SHOPEE_AFFILIATE_APP_ID=""
SHOPEE_AFFILIATE_SECRET=""
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
